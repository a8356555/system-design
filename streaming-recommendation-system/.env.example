# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/streaming

# Redis Configuration  
REDIS_URL=redis://localhost:6379

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# Recommendation Settings
CACHE_TTL_SECONDS=3600
MAX_RECOMMENDATIONS=100
SIMILARITY_THRESHOLD=0.3
PERSONALIZATION_THRESHOLD=5

# Feature Flags
ENABLE_REALTIME_RECOMMENDATIONS=True
ENABLE_DEVICE_OPTIMIZATION=True
ENABLE_GENRE_EXPLORATION=True
ENABLE_TRENDING_BOOST=True

# External Services (Optional)
CONTENT_METADATA_API_URL=
ANALYTICS_SERVICE_URL=
NOTIFICATION_SERVICE_URL=